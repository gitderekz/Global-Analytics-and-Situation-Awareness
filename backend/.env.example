PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=change-this-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=analytics_user
DB_PASSWORD=analytics_pass
DB_NAME=global_analytics_platform

# Map Services
MAP_SERVER_URL=http://localhost:3650
MAPTILER_API_KEY=your_api_key_here

# API Configuration
CORS_ORIGIN=http://localhost:5173
VITE_MAP_URL=http://localhost:3650/styles/basic/style.json

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@global-analytics.local
SMTP_SECURE=false
ENABLE_EMAIL_NOTIFICATIONS=true

# SMS Notifications (Optional)
ENABLE_SMS_NOTIFICATIONS=false
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# Redis (Optional - for Bull job queue)
REDIS_URL=redis://localhost:6379
MBTILES_PATH=./backend/uploads/mbtiles/tiles.mbtiles
MAPTILER_STYLE_URL=http://localhost:3650/styles/basic/style.json

# Logging
LOG_LEVEL=info
